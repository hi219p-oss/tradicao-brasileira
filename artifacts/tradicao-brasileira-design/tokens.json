{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F2EDDF" },
      "foreground": { "$value": "#10271D" },
      "border": { "$value": "#CFC5AE" },
      "card": { "$value": "#FAF6EC" },
      "cardForeground": { "$value": "#10271D" },
      "popover": { "$value": "#FAF6EC" },
      "popoverForeground": { "$value": "#10271D" },
      "primary": {
        "$value": "#092219",
        "$description": "Verde profundo extraído da identidade visual do projeto."
      },
      "primaryForeground": { "$value": "#F4EAD5" },
      "secondary": { "$value": "#E7DFCB" },
      "secondaryForeground": { "$value": "#10271D" },
      "muted": { "$value": "#EEE7D7" },
      "mutedForeground": { "$value": "#45564A" },
      "accent": {
        "$value": "#D39A3F",
        "$description": "Dourado do projeto; usar como destaque, não como fundo dominante."
      },
      "accentForeground": { "$value": "#10271D" },
      "destructive": { "$value": "#913F34" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#B9AA8B" },
      "ring": { "$value": "#8A662E" },
      "chart1": { "$value": "#092219" },
      "chart2": { "$value": "#D39A3F" },
      "chart3": { "$value": "#A65C44" },
      "chart4": { "$value": "#647B52" },
      "chart5": { "$value": "#577B7E" },
      "sidebar": { "$value": "#EAE2D1" },
      "sidebarForeground": { "$value": "#10271D" },
      "sidebarBorder": { "$value": "#CFC5AE" },
      "sidebarPrimary": { "$value": "#092219" },
      "sidebarPrimaryForeground": { "$value": "#F4EAD5" },
      "sidebarAccent": { "$value": "#E2D8C1" },
      "sidebarAccentForeground": { "$value": "#10271D" },
      "sidebarRing": { "$value": "#8A662E" }
    },
    "dark": {
      "background": { "$value": "#06180F" },
      "foreground": { "$value": "#F4EAD5" },
      "border": { "$value": "#385343" },
      "card": { "$value": "#0D2B1D" },
      "cardForeground": { "$value": "#F4EAD5" },
      "popover": { "$value": "#0D2B1D" },
      "popoverForeground": { "$value": "#F4EAD5" },
      "primary": { "$value": "#D39A3F" },
      "primaryForeground": { "$value": "#10271D" },
      "secondary": { "$value": "#173C2C" },
      "secondaryForeground": { "$value": "#F4EAD5" },
      "muted": { "$value": "#142F23" },
      "mutedForeground": { "$value": "#C5CDBF" },
      "accent": { "$value": "#E1B25D" },
      "accentForeground": { "$value": "#10271D" },
      "destructive": { "$value": "#D77B67" },
      "destructiveForeground": { "$value": "#1A100F" },
      "input": { "$value": "#53695B" },
      "ring": { "$value": "#E1B25D" },
      "chart1": { "$value": "#D39A3F" },
      "chart2": { "$value": "#8FA87A" },
      "chart3": { "$value": "#D48765" },
      "chart4": { "$value": "#8DB1A8" },
      "chart5": { "$value": "#E1D0AD" },
      "sidebar": { "$value": "#06180F" },
      "sidebarForeground": { "$value": "#F4EAD5" },
      "sidebarBorder": { "$value": "#385343" },
      "sidebarPrimary": { "$value": "#D39A3F" },
      "sidebarPrimaryForeground": { "$value": "#10271D" },
      "sidebarAccent": { "$value": "#173C2C" },
      "sidebarAccentForeground": { "$value": "#F4EAD5" },
      "sidebarRing": { "$value": "#E1B25D" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Interface and body copy, taken from the existing project styles."
      },
      "serif": {
        "$value": ["Fraunces", "Georgia", "serif"],
        "$description": "Editorial display and section headings from the existing project styles."
      },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
